# 複製成 .env 後修改。.env 不會進版控。

# --- 應用程式 ---
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- 本機帳號登入 ---
AUTH_SESSION_COOKIE=eq_session
AUTH_SESSION_TTL_HOURS=12
# 本機 HTTP 開發用；正式環境必須設 true 並使用 HTTPS
AUTH_COOKIE_SECURE=false
AUTH_MAX_LOGIN_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=300

# --- 資料庫 ---
# docker compose 用這個（服務名稱 db）：
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/regplatform
# 本機直接跑 uvicorn（不想裝 PostgreSQL）可以改用 SQLite：
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DB_ECHO=false

# --- 檔案上傳 ---
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.docx,.pdf,.txt,.xls,.xlsx

# --- 比對門檻 ---
# >= AUTO：高信心，直接採用法規狀態
# >= POSSIBLE 且 < AUTO：仍採用法規狀態但標記「疑似」，也是 LLM 輔助判斷的觸發區間
# <  POSSIBLE：判定為 NOT_FOUND
MATCH_AUTO_THRESHOLD=0.90
MATCH_POSSIBLE_THRESHOLD=0.70

# --- AI ---
# 設成 false 可完全關閉 AI（系統仍可完整運作，只是召回率與信心下降）
ENABLE_LLM_FALLBACK=true
# anthropic = Claude（要填 ANTHROPIC_API_KEY）
# demo      = 不呼叫模型的示範規則，沒有 API key 時用來看 AI 流程（紀錄會標明「非真實 AI」）
# null      = 完全不用 AI
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# 法規問答（「搜尋」分頁的「問 AI」，docs/regulation-qa.md）。和抽取分開設定
QA_MODEL=claude-opus-5-5
QA_EFFORT=medium
QA_TOP_K=8
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096

# --- 語意搜尋（法規條文與規範章節，docs/semantic-search.md） ---
# none  = 不載入模型，只用條號比對＋字詞相似度（預設；不需要 torch）
# local = 本機 sentence-transformers 模型：pip install -r requirements-semantic.txt，
#         再執行 python scripts/build_search_index.py 建向量索引
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=BAAI/bge-m3

# --- 外部法規來源 ---
# 逗號分隔，**順序即優先順序**（排在前面的來源優先，不會被後面的覆蓋）。
#   taiwan_law = 法務部全國法規資料庫（法律 + 法規命令，約 11,800 筆）
#                使用前先執行一次 python scripts/sync_taiwan_law.py 建立本地索引
#   pcces      = 工程會公共工程施工綱要規範目錄（先執行 python scripts/sync_pcces.py）
#   enterprise = 企業內部文件（品質手冊、程序書、作業標準…），各租戶在「總覽」匯入 Excel 清單
#   admin_rules = 行政規則與地方法規目錄（工程會要點、新北市自治條例…；名稱真實，狀態日期多為假資料）
#   standards_demo = 示範標準目錄（CNS/ISO/ASTM 假資料，含最新版次與廢止），示範標準怎麼判定
#   mock       = 離線 Demo 用的假資料
# 只用官方資料：REGULATION_SOURCES=taiwan_law
# 官方資料 + 企業內部文件：REGULATION_SOURCES=taiwan_law,pcces,enterprise
# 再補行政規則與地方法規（示範）：REGULATION_SOURCES=taiwan_law,pcces,admin_rules,enterprise
# 官方資料 + 假資料補 CNS/規範（Demo 用）：REGULATION_SOURCES=taiwan_law,mock
REGULATION_SOURCES=mock
REGULATION_CACHE_TTL_DAYS=7
# 全國法規資料庫的本地索引位置。整行註解掉 = 使用預設 data/taiwan_law_index.json
# （不要設成空字串，那會被解析成路徑 "."）
# TAIWAN_LAW_INDEX_PATH=/app/data/generated/taiwan_law_index.json

# --- OCR（掃描版 PDF） ---
# 可選取文字不足、但有圖片的頁才會送 OCR。辨識出的段落會標示「可能有錯字」。
ENABLE_OCR=true
OCR_LANGUAGES=chi_tra+eng
OCR_DPI=300
# Tesseract 語言資料目錄（要有 chi_tra.traineddata）。整行註解掉 = 用 TESSDATA_PREFIX 或系統安裝位置
# TESSDATA_PATH=C:/Users/<你>/AppData/Local/tessdata
# 選用：tessdata_best 的 chi_tra、chi_tra_vert、eng 放的目錄。掃描契約圖讀不出圖名的頁會用它補讀
# TESSDATA_BEST_PATH=C:/Users/<你>/AppData/Local/tessdata_best

# --- 報告 ---
# PDF 匯出用的中文字型（.ttf/.ttc）。留空 = 自動搜尋常見系統字型
PDF_FONT_PATH=

# --- Log ---
LOG_LEVEL=INFO
LOG_JSON=true
